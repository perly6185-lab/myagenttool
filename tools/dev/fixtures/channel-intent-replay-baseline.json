    { "id": "channel-016", "text": "给客户发邮件，会议下周再约", "source": "acceptance_baseline", "expected": { "taskKinds": ["business_communication"] } },
    { "id": "channel-017", "text": "只约王总开会，不要发邮件", "source": "acceptance_baseline", "expected": { "taskKinds": ["business_scheduling"] } },
    { "id": "channel-018", "text": "做一段口播和一个短视频", "source": "acceptance_baseline", "expected": { "taskKinds": ["content_voiceover", "content_video"] } },
