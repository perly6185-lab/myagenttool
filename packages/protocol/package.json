    },
    "./identity": {
      "types": "./src/identity.ts",
      "default": "./src/identity.mjs"
    },
    "./canvas": {
      "types": "./src/canvas.ts",
      "default": "./src/canvas.mjs"
    },
    "./codex-permissions": {
      "types": "./src/codex-permissions.ts",
      "default": "./src/codex-permissions.mjs"
    },
    "./agent-models": {
      "types": "./src/agent-models.ts",
      "default": "./src/agent-models.mjs"
    },
    "./business-routine": {
      "types": "./src/business-routine.ts",
      "default": "./src/business-routine.mjs"
    },
    "./task-resources": {
      "types": "./src/task-resources.ts",
