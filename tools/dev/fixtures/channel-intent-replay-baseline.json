    { "id": "channel-045", "text": "客户投诉比较急，分下优先级，再给我一版回复", "source": "professional_natural_baseline", "expected": { "taskKinds": ["support_case_triage", "support_response_draft"] } },
    { "id": "channel-046", "text": "法务合同审一下，财务对账一下，最后做个汇报PPT", "source": "professional_cross_domain_baseline", "expected": { "taskKinds": ["finance_reconciliation", "legal_contract_review", "presentation_creation"] } }
