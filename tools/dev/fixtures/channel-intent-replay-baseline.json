    { "id": "channel-012", "text": "修复登录错误并测试，部署先别做", "source": "acceptance_baseline", "expected": { "taskKinds": ["software_implementation", "software_verification"] } },
    { "id": "channel-013", "text": "根据分析结果整理成一篇技术文章", "source": "acceptance_baseline", "expected": { "taskKinds": ["content_article"] } },
    { "id": "channel-014", "text": "整理一份客户名单表格", "source": "acceptance_baseline", "expected": { "taskKinds": ["business_document"] } },
