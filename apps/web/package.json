{
  "name": "@myagenttool/web",
  "version": "0.0.0",
  "private": true,
  "description": "M0 local demo Web Console (React + Vite control-plane shell).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node ./src/index.mjs",
    "test": "node ./src/index.mjs --check && vitest run",
    "test:unit": "vitest run",
    "lint": "node ./src/index.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@myagenttool/protocol": "workspace:*",
    "@myagenttool/shared": "workspace:*",
    "@tanstack/react-query": "^5.62.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "pdfjs-dist": "6.1.200",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.9"
  }
}
