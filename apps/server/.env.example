# Server development defaults.
# Copy to .env.local for local overrides. Do not commit secrets.

SERVER_HOST=127.0.0.1
SERVER_PORT=5001

# Public article import queue and per-article media download limits.
MYAGENTTOOL_ARTICLE_IMPORT_MAX_CONCURRENT=2
MYAGENTTOOL_ARTICLE_MEDIA_CONCURRENCY=4

# External issue providers. Keep real values in .env.local or a secret manager.
MYAGENTTOOL_GITLAB_BASE_URL=https://gitlab.com
MYAGENTTOOL_GITLAB_TOKEN=
MYAGENTTOOL_GITLAB_WEBHOOK_SECRET=
MYAGENTTOOL_GITEA_BASE_URL=
MYAGENTTOOL_GITEA_TOKEN=
MYAGENTTOOL_GITEA_WEBHOOK_SECRET=
