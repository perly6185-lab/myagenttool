{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myagenttool.local/design/prototypes/canvas/scene-graph.schema.json",
  "title": "MyAgentTool Prototype Canvas Scene Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "source",
    "productFlow",
    "canvas",
    "surfaces"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ascii", "html", "fixture"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "productFlow": {
      "$ref": "#/$defs/productFlow"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinateSystem", "viewport", "grid"],
      "properties": {
        "coordinateSystem": {
          "type": "string",
          "enum": ["infinite"]
        },
        "viewport": {
          "$ref": "#/$defs/rect"
        },
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "visible"],
          "properties": {
            "size": {
              "type": "number"
            },
            "visible": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "role",
        "productFlow",
        "prototypeStates",
        "acceptanceSignals",
        "whatNotToShow",
        "bounds",
        "regions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["home", "detail", "modal", "export"]
        },
        "role": {
          "type": "string",
          "enum": ["ordinary_developer", "advanced_developer", "team_administrator", "auditor", "multi_role"]
        },
        "productFlow": {
          "$ref": "#/$defs/productFlow"
        },
        "prototypeStates": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "acceptanceSignals": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "whatNotToShow": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "bounds": {
          "$ref": "#/$defs/rect"
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/region"
          }
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "ownerSurface",
        "frequency",
        "role",
        "productFlow",
        "prototypeStates",
        "acceptanceSignals",
        "whatNotToShow",
        "bounds",
        "elements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ownerSurface": {
          "type": "string",
          "minLength": 1
        },
        "frequency": {
          "type": "string",
          "enum": ["high", "medium", "low", "low_critical"]
        },
        "role": {
          "type": "string",
          "enum": ["ordinary_developer", "advanced_developer", "team_administrator", "auditor", "multi_role"]
        },
        "productFlow": {
          "$ref": "#/$defs/productFlow"
        },
        "prototypeStates": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "acceptanceSignals": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "whatNotToShow": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "bounds": {
          "$ref": "#/$defs/rect"
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "bounds"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "type": {
          "type": "string",
          "enum": ["heading", "text", "textarea", "select", "radio", "button", "status", "timeline", "result", "metric", "link"]
        },
        "label": {
          "type": "string"
        },
        "variant": {
          "type": "string",
          "enum": ["primary", "secondary", "muted", "warning", "danger", "info"]
        },
        "stateBinding": {
          "type": "string"
        },
        "interaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["open_surface", "change_state", "submit", "cancel", "none"]
            },
            "target": {
              "type": "string"
            }
          }
        },
        "bounds": {
          "$ref": "#/$defs/rect"
        }
      }
    },
    "productFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleFlow",
        "scenario",
        "frequency",
        "ownerSurface",
        "usabilityTask",
        "partialAcceptanceOrFollowUp"
      ],
      "properties": {
        "roleFlow": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "frequency": {
          "type": "string",
          "minLength": 1
        },
        "ownerSurface": {
          "type": "string",
          "minLength": 1
        },
        "usabilityTask": {
          "type": "string",
          "minLength": 1
        },
        "partialAcceptanceOrFollowUp": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
