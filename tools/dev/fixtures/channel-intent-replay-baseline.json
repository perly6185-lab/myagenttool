    { "id": "channel-005", "text": "基于资料写文章，再做三张图片", "source": "acceptance_baseline", "expected": { "taskKinds": ["content_article", "content_image"] } },
    { "id": "channel-006", "text": "不要写文章，只做三张配图", "source": "acceptance_baseline", "expected": { "taskKinds": ["content_image"] } },
