{
  "name": "@myagenttool/protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Shared protocol schemas and event types placeholder.",
  "type": "module",
  "main": "src/index.mjs",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.mjs"
    },
    "./issue-prompt": {
      "types": "./src/issue-prompt.ts",
      "default": "./src/issue-prompt.mjs"
    },
    "./channel": {
      "types": "./src/channel.ts",
      "default": "./src/channel.mjs"
    }
  },
  "scripts": {
    "dev": "node ./src/index.mjs",
    "test": "node ./src/index.mjs --check && node --test test/*.test.mjs",
    "lint": "node ./src/index.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
