{
  "name": "@myagenttool/server",
  "version": "0.0.0",
  "private": true,
  "description": "M0 local demo server.",
  "type": "module",
  "scripts": {
    "dev": "node ./src/index.mjs",
    "test": "node ./src/index.mjs --check && node --test test/*.test.mjs && node --test test/integration/*.test.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' test/*.test.mjs test/integration/*.test.mjs",
    "lint": "node ./src/index.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@myagenttool/adapters": "workspace:*",
    "@myagenttool/protocol": "workspace:*",
    "@myagenttool/shared": "workspace:*",
    "@napi-rs/canvas": "^1.0.2",
    "@openai/codex": "0.146.0-alpha.3",
    "exceljs": "^4.4.0",
    "parse5": "^7.3.0",
    "pdfjs-dist": "^6.2.108",
    "ssh2": "1.17.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "jszip": "^3.10.1",
    "typescript": "^5.7.2"
  }
}
