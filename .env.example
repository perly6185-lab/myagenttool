# Root development defaults.
# Copy to .env.local for local overrides. Do not commit secrets.

MYAGENTTOOL_ENV=development

# Claude Agent SDK is the default transport. Set `cli` for immediate rollback.
# MYAGENTTOOL_CLAUDE_RUNTIME=cli

# Optional absolute Claude executable used by the SDK instead of its pinned
# native binary. This is separate from the CLI fallback command.
# MYAGENTTOOL_CLAUDE_SDK_EXECUTABLE=C:\Users\me\.local\bin\claude.exe
# Automatically derive platform-owned verification from changed test/source
# files when no explicit allowlisted Auto-run verification command is selected.
MYAGENTTOOL_AUTORUN_VERIFY_AUTO=1
MYAGENTTOOL_AUTORUN_VERIFY_TIMEOUT_MS=900000

# Optional local-only semantic refinement for already-opened mail. Enablement,
# URL, and model are required; the URL must be loopback HTTP. No mail body is sent to an
# external host, and header-only organization works without this feature.
# MYAGENTTOOL_MAIL_SEMANTIC_AI_ENABLED=0
# MYAGENTTOOL_MAIL_SEMANTIC_AI_URL=http://127.0.0.1:11434/analyze
# MYAGENTTOOL_MAIL_SEMANTIC_AI_MODEL=local-mail-model
# MYAGENTTOOL_MAIL_SEMANTIC_AI_TIMEOUT_MS=12000
# MYAGENTTOOL_MAIL_SEMANTIC_AI_CONCURRENCY=2

# Provider folder creation and mail moves are a distinct, approval-gated write
# boundary (ADR 0029). Keep dark unless the separate imap.organize credential
# has been explicitly connected on this device.
# MYAGENTTOOL_MAIL_ORGANIZE_ENABLED=0
# Read-only smart classification is the first rollout stage and defaults on.
# Set to 0 for an emergency rollback that leaves the ordinary inbox available.
# MYAGENTTOOL_MAIL_CLASSIFICATION_ENABLED=1
# Manual organization may be opened independently of automatic organization.
# The legacy MYAGENTTOOL_MAIL_ORGANIZE_ENABLED flag above remains an alias.
# MYAGENTTOOL_MAIL_ORGANIZE_MANUAL_ENABLED=0
# Automatic organization is always a separate, default-off release gate.
# Optionally constrain it to comma-separated mailbox application IDs.
# MYAGENTTOOL_MAIL_ORGANIZE_AUTO_ENABLED=0
# MYAGENTTOOL_MAIL_ORGANIZE_AUTO_ACCOUNTS=app_163_mail_v2

# Derived local SQLite fast path for large mailbox filtering and pagination.
# It is enabled by default, contains no provider credentials, and can be deleted
# and rebuilt from durable state. Set to 0 to use the legacy in-memory read path.
# MYAGENTTOOL_MAIL_QUERY_INDEX=1

# Loopback trust boundary (#1616). When set (>= 32 chars), every /api request
# must present this value in X-Loopback-Token or ride an authenticated cookie
# session. The Electron shell mints a fresh token per launch automatically;
# `pnpm dev` runs without one. Never commit a real value.
# MYAGENT_LOOPBACK_TOKEN=
# Extra hostnames (comma-separated, no ports) the server may be addressed by.
# Loopback names (127.0.0.1, localhost, ::1) are always allowed; anything else
# in the Host header is rejected as a DNS-rebinding probe.
# MYAGENT_ALLOWED_HOSTS=
