    { "id": "channel-036", "text": "先准备付款申请，再提交付款申请", "source": "professional_side_effect_baseline", "expected": { "taskKinds": ["finance_payment_request_draft", "finance_payment_request"] } },
    { "id": "channel-037", "text": "先起草采购申请，再送审采购申请", "source": "professional_side_effect_baseline", "expected": { "taskKinds": ["procurement_approval_draft", "procurement_approval_request"] } },
    { "id": "channel-038", "text": "把北京和上海两份销售数据分别分析一下", "source": "professional_multi_instance_baseline", "expected": { "taskKinds": ["data_analysis", "data_analysis"] } },
    { "id": "channel-039", "text": "A合同和B合同分别审查风险", "source": "professional_multi_instance_baseline", "expected": { "taskKinds": ["legal_contract_review", "legal_contract_review"] } },
    { "id": "channel-040", "text": "分别跟进甲公司和乙公司两个客户", "source": "professional_multi_instance_baseline", "expected": { "taskKinds": ["sales_followup", "sales_followup"] } },
    { "id": "channel-041", "text": "把中文、日文和韩文三份说明分别翻成英文", "source": "professional_multi_instance_baseline", "expected": { "taskKinds": ["document_translation", "document_translation", "document_translation"] } },
    { "id": "channel-042", "text": "先别走款，付款申请单给我准备一份", "source": "professional_side_effect_baseline", "expected": { "taskKinds": ["finance_payment_request_draft"] } },
    { "id": "channel-043", "text": "三家报价比一下，申请单先准备好，今天不要送审", "source": "professional_side_effect_baseline", "expected": { "taskKinds": ["procurement_quote_comparison", "procurement_approval_draft"] } },
