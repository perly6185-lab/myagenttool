{
  "name": "myagenttool",
  "version": "0.0.0",
  "private": true,
  "description": "Personal and small-team Agent Control Plane.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "node tools/dev/run-local-demo.mjs",
    "test": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" --filter \"./tools/*\" --if-present test && pnpm smoke:local",
    "lint": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" --filter \"./tools/*\" --if-present lint",
    "typecheck": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" --filter \"./tools/*\" --if-present typecheck",
    "docs:check": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/docs/check-markdown-links.ps1",
    "ai:check": "node tools/ai/src/index.mjs --check",
    "ai:intake": "node tools/ai/src/index.mjs intake-brief",
    "ai:branch": "node tools/ai/src/index.mjs branch-plan",
    "ai:feedback": "node tools/ai/src/index.mjs feedback-convert",
    "ai:issue-tree": "node tools/ai/src/index.mjs issue-tree",
    "ai:manifest": "node tools/ai/src/index.mjs work-manifest",
    "ai:pm": "node tools/ai/src/index.mjs pm-brief",
    "ai:code-plan": "node tools/ai/src/index.mjs code-plan",
    "ai:scope-check": "node tools/ai/src/index.mjs scope-check",
    "ai:testing-plan": "node tools/ai/src/index.mjs testing-plan",
    "ai:review": "node tools/ai/src/index.mjs review-pr",
    "ai:run-work": "node tools/ai/src/index.mjs run-work",
    "ai:work-runner": "node tools/ai/src/index.mjs run-work",
    "ai:coding-adapter-contract": "node tools/ai/src/index.mjs coding-adapter-contract",
    "github:check": "node tools/github/src/index.mjs --check",
    "github:check:issues": "node tools/github/src/index.mjs check-issues",
    "github:check:pr": "node tools/github/src/index.mjs check-pr",
    "github:check:branch": "node tools/github/src/index.mjs check-branch-protection",
    "release:check": "node tools/release/src/index.mjs --check",
    "release:draft": "node tools/release/src/index.mjs draft-notes",
    "release:retrospective": "node tools/release/src/index.mjs retrospective",
    "deploy:check": "node tools/deploy/src/index.mjs --check",
    "deploy:plan": "node tools/deploy/src/index.mjs plan",
    "deploy:preflight": "node tools/deploy/src/index.mjs preflight",
    "deploy:run": "node tools/deploy/src/index.mjs run",
    "deploy:publish": "node tools/deploy/src/index.mjs publish",
    "repo:check": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/docs/check-repo-health.ps1",
    "smoke:local": "node tools/dev/local-smoke.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
