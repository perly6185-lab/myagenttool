# Server development defaults.
# Copy to .env.local for local overrides. Do not commit secrets.

SERVER_HOST=127.0.0.1
SERVER_PORT=5001

# Public article import queue and per-article media download limits.
MYAGENTTOOL_ARTICLE_IMPORT_MAX_CONCURRENT=2
MYAGENTTOOL_ARTICLE_MEDIA_CONCURRENCY=4

# Feishu public-document import — a Playwright-backed provider branch of
# article-imports. MYAGENTTOOL_FEISHU_IMPORT_COMMAND_JSON optionally overrides
# the bundled fetcher argv (a JSON array); default is
# ["<node>", "<repo>/tools/feishu-doc-imports/src/cli.mjs"]. Requires a local
# chromium: `pnpm exec playwright install chromium`.
MYAGENTTOOL_FEISHU_IMPORT_COMMAND_JSON=
MYAGENTTOOL_FEISHU_IMPORT_TIMEOUT_MS=180000

# External issue providers. Keep real values in .env.local or a secret manager.
MYAGENTTOOL_GITLAB_BASE_URL=https://gitlab.com
MYAGENTTOOL_GITLAB_TOKEN=
MYAGENTTOOL_GITLAB_WEBHOOK_SECRET=
MYAGENTTOOL_GITEA_BASE_URL=
MYAGENTTOOL_GITEA_TOKEN=
MYAGENTTOOL_GITEA_WEBHOOK_SECRET=

# Optional Bridge-backed supplement/new-task classifier. Disabled by default so
# ordinary channel messages do not consume an extra invocation slot.
MYAGENTTOOL_CHANNEL_INTENT_ENABLED=0
MYAGENTTOOL_CHANNEL_INTENT_AGENT_ID=agt_codex_cli
MYAGENTTOOL_CHANNEL_INTENT_TIMEOUT_MS=8000
MYAGENTTOOL_CHANNEL_INTENT_FAILURE_THRESHOLD=3
MYAGENTTOOL_CHANNEL_INTENT_COOLDOWN_MS=30000
